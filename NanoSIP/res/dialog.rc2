//-----------------------------ACCOUNT------------------------------------------

#define IDD_ACCOUNT_OFF_LABEL 19

// Y where the collapsed "Advanced" section would start (= buttons row when collapsed)
#define IDD_ACCOUNT_ADV_BASE 160
#define IDD_ACCOUNT_OFF_HIDE_CID IDD_ACCOUNT_ADV_BASE+73
#define IDD_ACCOUNT_OFFSET_KEEP_ALIVE IDD_ACCOUNT_ADV_BASE+130

#define IDD_ACCOUNT_OFFSET_BUTTONS_EXPANDED IDD_ACCOUNT_ADV_BASE + 179

#define IDD_ACCOUNT_OFF_FINAL IDD_ACCOUNT_OFFSET_BUTTONS_EXPANDED + 19

IDD_ACCOUNT DIALOGEX 0, 0, 236, IDD_ACCOUNT_OFF_FINAL
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP | WS_VISIBLE
CAPTION "Account"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
RTEXT
"Account Name"
, IDC_STATIC, 7, 10, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_ACCOUNT_LABEL, 86, 7, 127, 14, ES_AUTOHSCROLL
RTEXT           "SIP Server", IDC_STATIC, 7, 29, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_SERVER, 86, 26, 127, 14, ES_AUTOHSCROLL
LTEXT           "*", IDC_ACCOUNT_REQUIRED_USERNAME, 78, 48, 8, 5
RTEXT
"Username"
, IDC_STATIC, 7, 48, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_USERNAME, 86, 45, 127, 14, ES_AUTOHSCROLL
LTEXT           "*", IDC_ACCOUNT_REQUIRED_DOMAIN, 78, 67, 8, 5
RTEXT           "Domain", IDC_STATIC, 7, 67, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_DOMAIN, 86, 64, 127, 14, ES_AUTOHSCROLL
RTEXT           "Login", IDC_STATIC, 7, 86, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_AUTHID, 86, 83, 127, 14, ES_AUTOHSCROLL
RTEXT
"Password"
, IDC_STATIC, 7, 105, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_PASSWORD, 86, 102, 127, 14, ES_AUTOHSCROLL | ES_PASSWORD
RTEXT           "Display Name", IDC_STATIC, 7, 124, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_DISPLAYNAME, 86, 121, 127, 14, ES_AUTOHSCROLL
CONTROL         "<a>Advanced</a>", IDC_SYSLINK_ACCOUNT_ADVANCED, "SysLink", WS_TABSTOP, 7, 140, 206, 8

RTEXT           "SIP Proxy", IDC_ACCOUNT_LBL_PROXY, 7, 3 + IDD_ACCOUNT_ADV_BASE, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_EDIT_PROXY, 86, IDD_ACCOUNT_ADV_BASE, 127, 14, ES_AUTOHSCROLL
RTEXT           "Dialing Prefix", IDC_ACCOUNT_LBL_DIALING_PREFIX, 7, 22 + IDD_ACCOUNT_ADV_BASE, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_ACCOUNT_DIALING_PREFIX, 86, 19 + IDD_ACCOUNT_ADV_BASE, 127, 14, ES_AUTOHSCROLL
RTEXT           "Dial Plan", IDC_ACCOUNT_LBL_DIAL_PLAN, 7, 41 + IDD_ACCOUNT_ADV_BASE, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_ACCOUNT_DIAL_PLAN, 86, 38 + IDD_ACCOUNT_ADV_BASE, 127, 14, ES_AUTOHSCROLL
CONTROL         "Hide Caller ID", IDC_ACCOUNT_HIDE_CID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 86, 57 + IDD_ACCOUNT_ADV_BASE, 127, 10
RTEXT           "Transport", IDC_ACCOUNT_LBL_TRANSPORT, 7, 3 + IDD_ACCOUNT_OFF_HIDE_CID, 70, 8, SS_WORDELLIPSIS
COMBOBOX        IDC_TRANSPORT, 86, IDD_ACCOUNT_OFF_HIDE_CID, 127, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
RTEXT           "Public Address", IDC_ACCOUNT_LBL_PUBLIC_ADDR, 7, 22 + IDD_ACCOUNT_OFF_HIDE_CID, 70, 8, SS_WORDELLIPSIS
COMBOBOX        IDC_PUBLIC_ADDR, 86, 19 + IDD_ACCOUNT_OFF_HIDE_CID, 127, 30, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
RTEXT           "Register Refresh", IDC_ACCOUNT_LBL_REGISTER_REFRESH, 7, 41 + IDD_ACCOUNT_OFF_HIDE_CID, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_ACCOUNT_REGISTER_REFRESH, 86, 38 + IDD_ACCOUNT_OFF_HIDE_CID, 30, 14, ES_AUTOHSCROLL
RTEXT           "Keep-Alive", IDC_ACCOUNT_LBL_KEEP_ALIVE, 116, 41 + IDD_ACCOUNT_OFF_HIDE_CID, 70, 8, SS_WORDELLIPSIS
EDITTEXT        IDC_ACCOUNT_KEEP_ALIVE, 191, 38 + IDD_ACCOUNT_OFF_HIDE_CID, 20, 14, ES_AUTOHSCROLL
CONTROL         "Allow IP Rewrite", IDC_REWRITE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 86, IDD_ACCOUNT_OFFSET_KEEP_ALIVE, 127, 10
CONTROL         "ICE", IDC_ICE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 86, 12 + IDD_ACCOUNT_OFFSET_KEEP_ALIVE, 127, 10
CONTROL         "Disable Session Timers", IDC_SESSION_TIMER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 86, 24 + IDD_ACCOUNT_OFFSET_KEEP_ALIVE, 127, 10

CONTROL      "", IDC_SYSLINK_ACCOUNT_DELETE, "SysLink", 0x0, 5, 2 + IDD_ACCOUNT_OFFSET_BUTTONS_EXPANDED, 75, 8, NOT WS_VISIBLE
DEFPUSHBUTTON   "Save", IDOK, 83, IDD_ACCOUNT_OFFSET_BUTTONS_EXPANDED, 70, 14
PUSHBUTTON      "Cancel", IDCANCEL, 158, IDD_ACCOUNT_OFFSET_BUTTONS_EXPANDED, 70, 14
END
