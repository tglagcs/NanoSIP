COMBOBOX        IDC_SETTINGS_FWD, IDD_SETTINGS_OFFSET_COLUMN + 126, IDD_SETTINGS_OFFSET_3, 63, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
