#define IDD_SETTINGS_OFFSET_DISVID IDD_SETTINGS_OFFSET_1 + 13
#define IDD_SETTINGS_OFFSET_2 IDD_SETTINGS_OFFSET_DISVID + 48
#else
#define IDD_SETTINGS_OFFSET_2 IDD_SETTINGS_OFFSET_1
#endif

#define IDD_SETTINGS_OFFSET_PORTS IDD_SETTINGS_OFFSET_2 + 18

#define IDD_SETTINGS_OFFSET_DNS_SRV IDD_SETTINGS_OFFSET_PORTS + 18

#define IDD_SETTINGS_OFFSET_STUN IDD_SETTINGS_OFFSET_DNS_SRV + 18

#define IDD_SETTINGS_OFFSET_FINAL1 IDD_SETTINGS_OFFSET_STUN

// end column

// second column

#define IDD_SETTINGS_OFFSET_INITIAL2 IDD_SETTINGS_OFFSET_CUSTOM_INI

#define IDD_SETTINGS_OFFSET_RECORDING IDD_SETTINGS_OFFSET_INITIAL2 + 31

#define IDD_SETTINGS_OFFSET_3 IDD_SETTINGS_OFFSET_RECORDING + 15

#define IDD_SETTINGS_OFFSET_FWD IDD_SETTINGS_OFFSET_3 + 15

#define IDD_SETTINGS_OFFSET_FEATURE_CODES IDD_SETTINGS_OFFSET_FWD + 15

#define IDD_SETTINGS_OFFSET_PRE_CHECKBOXES IDD_SETTINGS_OFFSET_FEATURE_CODES + 5

#define IDD_SETTINGS_OFFSET_MEDIA_BUTTONS IDD_SETTINGS_OFFSET_PRE_CHECKBOXES + 11

#define IDD_SETTINGS_OFFSET_SOUND_EVENTS IDD_SETTINGS_OFFSET_MEDIA_BUTTONS + 11

#define IDD_SETTINGS_OFFSET_LOG_FILE IDD_SETTINGS_OFFSET_MEDIA_BUTTONS + 11

#define IDD_SETTINGS_OFFSET_CALL_WAITING IDD_SETTINGS_OFFSET_SOUND_EVENTS + 12

#define IDD_SETTINGS_OFFSET_CHECKBOXES IDD_SETTINGS_OFFSET_CALL_WAITING + 17

#define IDD_SETTINGS_OFFSET_UPDATES IDD_SETTINGS_OFFSET_CHECKBOXES

#define IDD_SETTINGS_OFFSET_STARTUP IDD_SETTINGS_OFFSET_UPDATES + 13

#define IDD_SETTINGS_OFFSET_CUSTOM_LINK IDD_SETTINGS_OFFSET_STARTUP

#define IDD_SETTINGS_OFFSET_FINAL2 IDD_SETTINGS_OFFSET_CUSTOM_LINK + 5

// end column

#define IDD_SETTINGS_OFFSET_FINAL IDD_SETTINGS_OFFSET_FINAL2 + 23

IDD_SETTINGS DIALOGEX 0, 0, 20 + 290 + IDD_SETTINGS_OFFSET_COLUMN, 20 + IDD_SETTINGS_OFFSET_FINAL
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP | WS_VISIBLE
CAPTION "Settings"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
RTEXT           "Ringtone", IDC_STATIC, 7, 2 + IDD_SETTINGS_OFFSET_WAV, 110, 8
CONTROL         "Ringtone Volume", IDC_SETTINGS_VOLUME_RING, "msctls_trackbar32", TBS_HORZ | TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 126, IDD_SETTINGS_OFFSET_WAV, 123, 12
RTEXT           "Ring Device", IDC_STATIC, 7, 2 + IDD_SETTINGS_OFFSET_SOUND_WELCOME, 110, 8
COMBOBOX        IDC_SETTINGS_RING, 126, IDD_SETTINGS_OFFSET_SOUND_WELCOME, 130, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
RTEXT
"Speaker"
, IDC_STATIC, 7, 17 + IDD_SETTINGS_OFFSET_SOUND_WELCOME, 110, 8
COMBOBOX        IDC_SETTINGS_SPEAKERS, 126, 15 + IDD_SETTINGS_OFFSET_SOUND_WELCOME, 130, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
RTEXT           "Microphone", IDC_STATIC, 7, 32 + IDD_SETTINGS_OFFSET_SOUND_WELCOME, 110, 8
COMBOBOX        IDC_SETTINGS_MICROPHONE, 126, 30 + IDD_SETTINGS_OFFSET_SOUND_WELCOME, 130, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
AUTOCHECKBOX   "Microphone Amplification", IDC_SETTINGS_MIC_AMPLIF, 56, IDD_SETTINGS_OFFSET_DEVICES2, 186, 10
AUTOCHECKBOX   "Software Level Adjustment", IDC_SETTINGS_SW_ADJUST, 56, IDD_SETTINGS_OFFSET_MIC_AMPLIF, 186, 10
CONTROL         "VAD", IDC_SETTINGS_VAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, IDD_SETTINGS_OFFSET_01, 25, 10
CONTROL         "EC", IDC_SETTINGS_EC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 56, IDD_SETTINGS_OFFSET_01, 25, 10
#ifdef _GLOBAL_VIDEO
CONTROL         "Disable Video", IDC_SETTINGS_DISABLE_VIDEO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 126, IDD_SETTINGS_OFFSET_1, 134, 10
RTEXT           "Camera", IDC_STATIC, 7, 2 + IDD_SETTINGS_OFFSET_DISVID, 110, 8
COMBOBOX        IDC_SETTINGS_VID_CAP_DEV, 126, IDD_SETTINGS_OFFSET_DISVID, 134, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "P", IDC_SETTINGS_PREVIEW, 264, IDD_SETTINGS_OFFSET_DISVID, 14, 12
RTEXT           "Video Codec", IDC_STATIC, 7, 17 + IDD_SETTINGS_OFFSET_DISVID, 110, 8
COMBOBOX        IDC_SETTINGS_VIDEO_CODEC, 126, 15 + IDD_SETTINGS_OFFSET_DISVID, 90, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "H.264", IDC_SETTINGS_VIDEO_H264, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 32 + IDD_SETTINGS_OFFSET_DISVID, 30, 10
CONTROL         "H.263+", IDC_SETTINGS_VIDEO_H263, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 60, 32 + IDD_SETTINGS_OFFSET_DISVID, 30, 10
CONTROL         "VP8", IDC_SETTINGS_VIDEO_VP8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 32 + IDD_SETTINGS_OFFSET_DISVID, 30, 10
CONTROL         "VP9", IDC_SETTINGS_VIDEO_VP9, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 32 + IDD_SETTINGS_OFFSET_DISVID, 30, 10
RTEXT           "Video Bitrate", IDC_STATIC, 170, 33 + IDD_SETTINGS_OFFSET_DISVID, 55, 8
EDITTEXT        IDC_SETTINGS_VIDEO_BITRATE, 227, 30 + IDD_SETTINGS_OFFSET_DISVID, 30, 14, ES_AUTOHSCROLL
#endif
RTEXT           "Source Port", IDC_STATIC, 2, 2 + IDD_SETTINGS_OFFSET_2, 75, 8
EDITTEXT        IDC_SETTINGS_SOURCE_PORT, 79, IDD_SETTINGS_OFFSET_2, 30, 14, ES_AUTOHSCROLL
AUTOCHECKBOX   "rport", IDC_SETTINGS_RPORT, 118, 2 + IDD_SETTINGS_OFFSET_2, 28, 10
RTEXT           "RTP Ports", IDC_STATIC, 146, 2 + IDD_SETTINGS_OFFSET_2, 40, 8
EDITTEXT        IDC_SETTINGS_RTP_PORT_MIN, 188, IDD_SETTINGS_OFFSET_2, 30, 14, ES_AUTOHSCROLL
CTEXT           "-", IDC_STATIC, 220, 2 + IDD_SETTINGS_OFFSET_2, 5, 8
EDITTEXT        IDC_SETTINGS_RTP_PORT_MAX, 227, IDD_SETTINGS_OFFSET_2, 30, 14, ES_AUTOHSCROLL

RTEXT           "Nameserver", IDC_STATIC, 7, 2 + IDD_SETTINGS_OFFSET_PORTS, 110, 8
EDITTEXT        IDC_SETTINGS_DNS_SRV_NS, 126, IDD_SETTINGS_OFFSET_PORTS, 100, 14, ES_AUTOHSCROLL
CONTROL         "DNS SRV", IDC_SETTINGS_DNS_SRV_CHECKBOX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 230, 2 + IDD_SETTINGS_OFFSET_PORTS, 50, 8

CONTROL         "STUN Server", IDC_SETTINGS_STUN_CHECKBOX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | BS_RIGHT | BS_RIGHTBUTTON, 7, 2 + IDD_SETTINGS_OFFSET_DNS_SRV, 110, 8
EDITTEXT        IDC_SETTINGS_STUN, 126, IDD_SETTINGS_OFFSET_DNS_SRV, 127, 14, ES_AUTOHSCROLL
CONTROL         "Call Recording", IDC_SETTINGS_RECORDING_CHECKBOX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | BS_RIGHT | BS_RIGHTBUTTON, IDD_SETTINGS_OFFSET_COLUMN + 7, 2 + IDD_SETTINGS_OFFSET_INITIAL2, 110, 8
