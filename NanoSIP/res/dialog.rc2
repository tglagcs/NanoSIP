LTEXT           "sec", IDC_STATIC, IDD_SETTINGS_OFFSET_COLUMN + 261, 2 + IDD_SETTINGS_OFFSET_3, 16, 8
CONTROL         "<a>Feature Codes</a>", IDC_SETTINGS_FEATURE_CODES, "SysLink", WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 126, IDD_SETTINGS_OFFSET_FWD, 127, 8

CONTROL             "Handle Media Buttons", IDC_SETTINGS_MEDIA_BUTTONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 20, IDD_SETTINGS_OFFSET_PRE_CHECKBOXES, 145, 10
CONTROL             "Headset Support", IDC_SETTINGS_HID, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 175, IDD_SETTINGS_OFFSET_PRE_CHECKBOXES, 135, 10
CONTROL         "Sound Events", IDC_SETTINGS_LOCAL_DTMF, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 20, IDD_SETTINGS_OFFSET_MEDIA_BUTTONS, 145, 10
CONTROL         "Bring to Front on Incoming Call", IDC_SETTINGS_BRING_TO_FRONT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | SS_PATHELLIPSIS, IDD_SETTINGS_OFFSET_COLUMN + 20, IDD_SETTINGS_OFFSET_SOUND_EVENTS, 145, 10
CONTROL         "Enable Local Account", IDC_SETTINGS_ENABLE_LOCAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 175, IDD_SETTINGS_OFFSET_LOG_FILE, 135, 10
CONTROL         "Multi Monitor Support", IDC_SETTINGS_MULTI_MONITOR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, IDD_SETTINGS_OFFSET_COLUMN + 20, IDD_SETTINGS_OFFSET_CALL_WAITING, 145, 10
