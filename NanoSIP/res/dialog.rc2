//--------------------------------MAIN---------------------------------------
IDD_MAIN DIALOGEX 0, 0, _GLOBAL_WIDTH, _GLOBAL_HEIGHT + 31
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
FONT 8, "Microsoft Sans Serif", 0, 0, 0x1
CLASS _GLOBAL_NAME
BEGIN
CONTROL         "", IDC_MAIN_TAB, "SysTabControl32", WS_TABSTOP, 0, 0
, _GLOBAL_WIDTH + 2, 16
PUSHBUTTON      "Menu", IDC_MAIN_MENU, _GLOBAL_WIDTH - 19, 3
, 16, 11, BS_ICON
END
//---------------------DIALER---------------------------------
#define IDD_DIALER_OFFSET_INITIAL 4

#define IDD_DIALER_OFFSET_USERNAME IDD_DIALER_OFFSET_INITIAL

#define IDD_DIALER_OFFSET_NUMBER IDD_DIALER_OFFSET_USERNAME+19

#define IDD_DIALER_OFFSET_DIALPAD IDD_DIALER_OFFSET_NUMBER+122

#define IDD_DIALER_OFFSET_BUTTONS IDD_DIALER_OFFSET_DIALPAD+27

#define IDD_DIALER_OFFSET_MICROPHONE IDD_DIALER_OFFSET_BUTTONS+40

#define IDD_DIALER_OFFSET_SPEAKER IDD_DIALER_OFFSET_MICROPHONE+4

#define IDD_DIALER_OFFSET_BOTTOM_BUTTONS IDD_DIALER_OFFSET_SPEAKER+19

#define IDD_DIALER_OFFSET_RELOGIN_BOTTOM IDD_DIALER_OFFSET_BOTTOM_BUTTONS

#define IDD_DIALER_OFFSET_LAST IDD_DIALER_OFFSET_RELOGIN_BOTTOM

IDD_DIALER DIALOGEX 0, 0, _GLOBAL_DIALER_WIDTH, _GLOBAL_HEIGHT
STYLE DS_SETFONT | WS_CHILD | WS_SYSMENU
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN

COMBOBOX        IDC_NUMBER, 4, IDD_DIALER_OFFSET_USERNAME, _GLOBAL_DIALER_WIDTH - 4 - 6, 23, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "Send", IDC_DIALER_DTMF, _GLOBAL_DIALER_WIDTH - 45 - 4, IDD_DIALER_OFFSET_USERNAME, 45, 23, NOT WS_VISIBLE

PUSHBUTTON      "1", IDC_KEY_1, 4, 3 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "2", IDC_KEY_2, 55, 3 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "3", IDC_KEY_3, 106, 3 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "4", IDC_KEY_4, 4, 26 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "5", IDC_KEY_5, 55, 26 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "6", IDC_KEY_6, 106, 26 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "7", IDC_KEY_7, 4, 49 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "8", IDC_KEY_8, 55, 49 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "9", IDC_KEY_9, 106, 49 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "0", IDC_KEY_0, 55, 72 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "*", IDC_KEY_STAR, 4, 72 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "#", IDC_KEY_GRATE, 106, 72 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "+", IDC_KEY_PLUS, 55, 95 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "<", IDC_DELETE, 4, 95 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW & ~WS_VISIBLE
PUSHBUTTON      "R", IDC_REDIAL, 4, 95 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW
PUSHBUTTON      "C", IDC_CLEAR, 106, 95 + IDD_DIALER_OFFSET_NUMBER, 51, 23, BS_OWNERDRAW

#ifdef _GLOBAL_VIDEO
PUSHBUTTON      "Call", IDC_CALL, 4 + 28, IDD_DIALER_OFFSET_DIALPAD, _GLOBAL_DIALER_WIDTH - 4 - 28 - 4, 23, WS_DISABLED
PUSHBUTTON      "Video Call", IDC_VIDEO_CALL, 4, IDD_DIALER_OFFSET_DIALPAD, 28, 23, WS_DISABLED | BS_ICON
#else
PUSHBUTTON      "Call", IDC_CALL, 4, IDD_DIALER_OFFSET_DIALPAD, _GLOBAL_DIALER_WIDTH - 4 - 4, 23, WS_DISABLED
#endif

PUSHBUTTON      "End", IDC_END, 4 + 28, IDD_DIALER_OFFSET_DIALPAD, _GLOBAL_DIALER_WIDTH - 4 - 28 - 4 - 28, 23, WS_DISABLED
CHECKBOX		"Hold", IDC_HOLD, 4, IDD_DIALER_OFFSET_DIALPAD, 28, 23, (BS_PUSHLIKE | WS_DISABLED | BS_ICON) & ~WS_VISIBLE
PUSHBUTTON      "Call Transfer", IDC_TRANSFER, _GLOBAL_DIALER_WIDTH - 4 - 28, IDD_DIALER_OFFSET_DIALPAD, 28, 23, (WS_DISABLED | BS_ICON) & ~WS_VISIBLE

CHECKBOX    "Mute Speaker", IDC_BUTTON_MUTE_OUTPUT, 4, 1 + IDD_DIALER_OFFSET_BUTTONS, 16, 16, BS_PUSHLIKE | BS_ICON
RTEXT           "_", IDC_BUTTON_MINUS_OUTPUT, 21, IDD_DIALER_OFFSET_BUTTONS + 1, 8, 8
CONTROL         "Speaker Level", IDC_VOLUME_OUTPUT, "msctls_trackbar32", TBS_HORZ | TBS_BOTH | TBS_NOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 29, IDD_DIALER_OFFSET_BUTTONS, _GLOBAL_DIALER_WIDTH - 20 - 10 - 11, 19
LTEXT           "+", IDC_BUTTON_PLUS_OUTPUT, _GLOBAL_DIALER_WIDTH - 12, IDD_DIALER_OFFSET_BUTTONS + 4, 8, 8
CHECKBOX    "Mute Microphone", IDC_BUTTON_MUTE_INPUT, 4, 1 + IDD_DIALER_OFFSET_BUTTONS + 20, 16, 16, BS_PUSHLIKE | BS_ICON
RTEXT           "_", IDC_BUTTON_MINUS_INPUT, 21, IDD_DIALER_OFFSET_BUTTONS + 20 + 1, 8, 8
CONTROL         "Microphone Level", IDC_VOLUME_INPUT, "msctls_trackbar32", TBS_HORZ | TBS_BOTH | TBS_NOTICKS | TBS_ENABLESELRANGE | WS_TABSTOP, 29, IDD_DIALER_OFFSET_BUTTONS + 20, _GLOBAL_DIALER_WIDTH - 20 - 10 - 11, 19
LTEXT           "+", IDC_BUTTON_PLUS_INPUT, _GLOBAL_DIALER_WIDTH - 12, IDD_DIALER_OFFSET_BUTTONS + 20 + 4, 8, 8
PUSHBUTTON      "Voicemail Number", IDC_DIALER_VOICEMAIL, _GLOBAL_DIALER_WIDTH - 4 - 2 - 21, IDD_DIALER_OFFSET_SPEAKER, 21, 11, BS_OWNERDRAW & ~WS_VISIBLE
PUSHBUTTON      "Voicemail Number", IDC_DIALER_VOICEMAIL_DISABLED, _GLOBAL_DIALER_WIDTH - 4 - 2 - 21, IDD_DIALER_OFFSET_SPEAKER, 21, 11, BS_OWNERDRAW & ~WS_VISIBLE
LTEXT           "", IDC_DIALER_LAST, 0, IDD_DIALER_OFFSET_LAST, 0, 0
END
//------------------------CALLS------------------------------------------
IDD_CALLS DIALOGEX 0, 0, _GLOBAL_WIDTH, 15 + IDD_CALLS_OFFSET_LISTVIEW
STYLE DS_SETFONT | WS_CHILD | WS_SYSMENU
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
CONTROL         "", IDC_CALLS, "SysListView32", LVS_REPORT | LVS_ALIGNLEFT | WS_TABSTOP, 0, 0, _GLOBAL_WIDTH, IDD_CALLS_OFFSET_LISTVIEW2
CONTROL			IDI_SEARCH, IDC_SEARCH_PICTURE, "Static", SS_ICON | SS_REALSIZECONTROL, 5, IDD_CALLS_OFFSET_LISTVIEW + 2, 11, 11
EDITTEXT        IDC_FILER_VALUE, 20, IDD_CALLS_OFFSET_LISTVIEW, _GLOBAL_WIDTH - 24, 14, ES_AUTOHSCROLL
END
//--------------------------------RINGIN---------------------------------------
#define IDD_RINGIN_OFFSET_INITIAL 14
#define IDD_RINGIN_OFFSET_NAME IDD_RINGIN_OFFSET_INITIAL+32
#define IDD_RINGIN_OFFSET_ADDR IDD_RINGIN_OFFSET_NAME+56
#ifdef _GLOBAL_VIDEO
#define IDD_RINGIN_OFFSET_VIDEO IDD_RINGIN_OFFSET_ADDR+19
#else
#define IDD_RINGIN_OFFSET_VIDEO IDD_RINGIN_OFFSET_ADDR
#endif
#define IDD_RINGIN_OFFSET_BUTTONS IDD_RINGIN_OFFSET_VIDEO+21
#define IDD_RINGIN_OFFSET_LIST IDD_RINGIN_OFFSET_BUTTONS
#define IDD_RINGIN_OFFSET_ADDL IDD_RINGIN_OFFSET_LIST+3

#define IDD_RINGIN_OFFSET_FINAL IDD_RINGIN_OFFSET_ADDL+12

IDD_RINGIN DIALOGEX 0, 0, _GLOBAL_RINGIN_WIDTH, IDD_RINGIN_OFFSET_FINAL
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP
CAPTION "Incoming Call"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
RTEXT           "", IDC_RINGIN_NAME_BLIND, 0, 0, 0, 0, WS_TABSTOP
#ifdef _GLOBAL_VIDEO
PUSHBUTTON      "Answer with Video", IDC_VIDEO, 5, IDD_RINGIN_OFFSET_ADDR, _GLOBAL_RINGIN_WIDTH - 10, 14, WS_DISABLED
#endif
PUSHBUTTON      "Answer", IDC_ANSWER, 5, IDD_RINGIN_OFFSET_VIDEO, 90 - 8, 14
PUSHBUTTON      "Decline", IDC_DECLINE, 90 + 3, IDD_RINGIN_OFFSET_VIDEO, 90 - 8, 14
CTEXT           "close window to ignore call", IDC_IGNORE, 25, IDD_RINGIN_OFFSET_ADDL - 4, _GLOBAL_RINGIN_WIDTH - 50, 16
PUSHBUTTON      "Transfer", IDC_TRANSFER, _GLOBAL_RINGIN_WIDTH - 5 - 20, IDD_RINGIN_OFFSET_ADDL - 6, 20, 14, BS_ICON

EDITTEXT           IDC_CALLER_NAME, 5, IDD_RINGIN_OFFSET_INITIAL, _GLOBAL_RINGIN_WIDTH - 10,
32
, ES_AUTOHSCROLL | ES_READONLY | ES_MULTILINE | ES_CENTER | WS_TABSTOP

EDITTEXT        IDC_CALLER_ADDR, 5, IDD_RINGIN_OFFSET_NAME, _GLOBAL_RINGIN_WIDTH - 10, 56, ES_AUTOHSCROLL | ES_READONLY | ES_MULTILINE | ES_CENTER

END
//--------------------------------TRANSFER---------------------------------------
#define IDD_TRANSFER_WIDTH 150
#define IDD_TRANSFER_OFFSET_LEFT 23
#define IDD_TRANSFER_OFFSET_NUMBER 23
#define IDD_TRANSFER_OFFSET_DIALPAD IDD_TRANSFER_OFFSET_NUMBER+75
IDD_TRANSFER DIALOGEX 0, 0, IDD_TRANSFER_WIDTH, IDD_TRANSFER_OFFSET_DIALPAD + 50
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_POPUP | WS_VISIBLE
CAPTION ""
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
COMBOBOX        IDC_NUMBER, IDD_TRANSFER_OFFSET_LEFT, 4, 105, 14, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON      "Attended Transfer", IDC_TRANSFER_ATTENDED, 4, IDD_TRANSFER_OFFSET_DIALPAD, 142, 14, NOT WS_VISIBLE
PUSHBUTTON      "Blind Transfer", IDC_TRANSFER_BLIND, 4, IDD_TRANSFER_OFFSET_DIALPAD + 16, 142, 14, NOT WS_VISIBLE
PUSHBUTTON      "OK", IDOK, 4, IDD_TRANSFER_OFFSET_DIALPAD + 16, 142, 14
PUSHBUTTON      "Cancel", IDCANCEL, 4, IDD_TRANSFER_OFFSET_DIALPAD + 16 + 16, 142, 14
PUSHBUTTON      "1", IDC_KEY_1, IDD_TRANSFER_OFFSET_LEFT, IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "2", IDC_KEY_2, IDD_TRANSFER_OFFSET_LEFT + 35, IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "3", IDC_KEY_3, IDD_TRANSFER_OFFSET_LEFT + 70, IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "4", IDC_KEY_4, IDD_TRANSFER_OFFSET_LEFT, 18 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "5", IDC_KEY_5, IDD_TRANSFER_OFFSET_LEFT + 35, 18 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "6", IDC_KEY_6, IDD_TRANSFER_OFFSET_LEFT + 70, 18 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "7", IDC_KEY_7, IDD_TRANSFER_OFFSET_LEFT, 36 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "8", IDC_KEY_8, IDD_TRANSFER_OFFSET_LEFT + 35, 36 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "9", IDC_KEY_9, IDD_TRANSFER_OFFSET_LEFT + 70, 36 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "0", IDC_KEY_0, IDD_TRANSFER_OFFSET_LEFT + 35, 54 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "*", IDC_KEY_STAR, IDD_TRANSFER_OFFSET_LEFT, 54 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
PUSHBUTTON      "#", IDC_KEY_GRATE, IDD_TRANSFER_OFFSET_LEFT + 70, 54 + IDD_TRANSFER_OFFSET_NUMBER, 35, 18
END
//--------------------------------MESSAGES---------------------------------------
#define IDD_MESSAGES_OFFSET_INITIAL 0

#define IDD_MESSAGING_OFFSET_HEADER 21
#define IDD_MESSAGING_OFFSET_BUTTONS IDD_MESSAGING_OFFSET_HEADER + 17

#define IDD_MESSAGING_OFFSET_LIST IDD_MESSAGING_OFFSET_BUTTONS + 32 + 4

#define IDD_MESSAGING_OFFSET_MESSAGE IDD_MESSAGING_OFFSET_LIST + 15 + 2

#define IDD_MESSAGING_OFFSET_FINAL IDD_MESSAGING_OFFSET_MESSAGE

IDD_MESSAGES DIALOGEX 0, 0, 299, IDD_MESSAGING_OFFSET_FINAL
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
FONT 8, "Microsoft Sans Serif", 400, 0, 0x1
BEGIN
CONTROL         "", IDC_MESSAGES_TAB, "SysTabControl32", WS_TABSTOP | NOT WS_VISIBLE, 0, 3, 168
, 15
PUSHBUTTON      "Last Call", IDC_LAST_CALL, 173, 3, 60, 14, WS_DISABLED
PUSHBUTTON      "Close All", IDC_CLOSE_ALL, 237, 3, 60, 14, WS_DISABLED
PUSHBUTTON      "Call", IDC_CALL_END, 4, IDD_MESSAGING_OFFSET_HEADER, 70, 14, NOT WS_VISIBLE
PUSHBUTTON      "Video Call", IDC_VIDEO_CALL, 78, IDD_MESSAGING_OFFSET_HEADER, 70, 14, NOT WS_VISIBLE
CHECKBOX        "Hold", IDC_HOLD, 103, IDD_MESSAGING_OFFSET_HEADER, 18, 14, BS_ICON | BS_PUSHLIKE | NOT WS_VISIBLE
PUSHBUTTON      "Transfer", IDC_TRANSFER, 123, IDD_MESSAGING_OFFSET_HEADER, 50, 14, NOT WS_VISIBLE
PUSHBUTTON      "Conference", IDC_CONFERENCE, 175, IDD_MESSAGING_OFFSET_HEADER, 50, 14, NOT WS_VISIBLE
PUSHBUTTON      "End", IDC_END, 227, IDD_MESSAGING_OFFSET_HEADER, 70, 14, NOT WS_VISIBLE
CONTROL         "", IDC_MESSAGES_LIST, "RichEdit20W", WS_VSCROLL | WS_TABSTOP | 0x2804, 1, IDD_MESSAGING_OFFSET_BUTTONS, 297, 32, WS_EX_STATICEDGE
CONTROL         "", IDC_MESSAGE, "RichEdit20W", WS_BORDER | WS_VSCROLL | WS_TABSTOP | 0x84 | WS_DISABLED, 1, IDD_MESSAGING_OFFSET_LIST, 296, 15
END
//--------------------------------SETTINGS---------------------------------------
#define IDD_SETTINGS_OFFSET_INITIAL 8

#define IDD_SETTINGS_OFFSET_COLUMN 290

// first column

#define IDD_SETTINGS_OFFSET_CUSTOM_INI IDD_SETTINGS_OFFSET_INITIAL

#define IDD_SETTINGS_OFFSET_WAV IDD_SETTINGS_OFFSET_CUSTOM_INI

#define IDD_SETTINGS_OFFSET_RINGTONE IDD_SETTINGS_OFFSET_WAV + 16

#define IDD_SETTINGS_OFFSET_AA_TONE IDD_SETTINGS_OFFSET_RINGTONE

#define IDD_SETTINGS_OFFSET_SOUND_WELCOME IDD_SETTINGS_OFFSET_AA_TONE

#define IDD_SETTINGS_OFFSET_DEVICES IDD_SETTINGS_OFFSET_SOUND_WELCOME + 46

#define IDD_SETTINGS_OFFSET_DEVICES2 IDD_SETTINGS_OFFSET_DEVICES

#define IDD_SETTINGS_OFFSET_MIC_AMPLIF IDD_SETTINGS_OFFSET_DEVICES2+12

#define IDD_SETTINGS_OFFSET_SW_ADJUST IDD_SETTINGS_OFFSET_MIC_AMPLIF+12

#define IDD_SETTINGS_OFFSET_01 IDD_SETTINGS_OFFSET_SW_ADJUST + 12

#define IDD_SETTINGS_OFFSET_1 IDD_SETTINGS_OFFSET_01 + 13

